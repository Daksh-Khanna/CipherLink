{
 "name": "@cipherlink/server",
 "version": "1.0.0",
 "private": true,
 "scripts": {
  "dev": "tsx watch src/index.ts",
  "start": "node dist/index.cjs",
  "build": "tsc --noEmit && node scripts/build.mjs",
  "typecheck": "tsc --noEmit",
  "db:setup": "node scripts/init-db.mjs && prisma generate && prisma migrate deploy",
  "test": "tsx --test --test-concurrency=1 tests/*.test.ts"
 },
 "dependencies": {
  "@cipherlink/shared": "1.0.0",
  "@prisma/client": "~6.19.0",
  "bcryptjs": "^3.0.2",
  "cors": "^2.8.5",
  "dotenv": "^17.2.3",
  "express": "^5.1.0",
  "express-rate-limit": "^8.2.1",
  "helmet": "^8.1.0",
  "jsonwebtoken": "^9.0.2",
  "socket.io": "^4.8.1",
  "zod": "^4.6.7"
 },
 "devDependencies": {
  "@types/cors": "^2.8.19",
  "@types/express": "^5.0.5",
  "@types/jsonwebtoken": "^9.0.10",
  "@types/node": "^24.10.0",
  "esbuild": "^0.28.2",
  "prisma": "~6.19.0",
  "socket.io-client": "^4.8.1",
  "tsx": "^4.20.6",
  "typescript": "~6.0.3"
 }
}
